<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone verification of the Box2D layer. No NuGet packages and no other Prowl code: the two binding
       files are compiled straight into this assembly, with the same language settings as Prowl.Runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\Prowl.Runtime\Physics2D\Native\*.cs" LinkBase="Native" />
    <Compile Include="..\..\..\..\Prowl.Runtime\Physics2D\*.cs" LinkBase="Core" />

    <!-- The REAL engine-facing 2D files, compiled unmodified against EngineStubs (see MiniEngine.cs). -->
    <Compile Include="..\..\..\..\Prowl.Runtime\Physics2D\Engine\*.cs" LinkBase="Engine" />
    <Compile Include="..\..\..\..\Prowl.Runtime\Components\Physics2D\*.cs" LinkBase="Components" />
    <Compile Include="..\..\..\..\Prowl.Runtime\PhysicsCommon\CollisionMatrix.cs" LinkBase="Engine" />
    <Compile Include="..\..\..\..\Prowl.Runtime\PhysicsCommon\ForceMode.cs" LinkBase="Engine" />
    <Compile Include="..\..\..\..\Prowl.Runtime\PhysicsCommon\RigidbodyInterpolation.cs" LinkBase="Engine" />
    <!-- The REAL inspector attributes, so the compiler checks every name, constructor and valid target I use. -->
    <Compile Include="..\..\..\..\Prowl.Runtime\GameObject\Attributes\InspectorAttributes.cs" LinkBase="Engine" />
    <Compile Include="..\..\..\..\Prowl.Runtime\ComponentIconAttribute.cs" LinkBase="Engine" />
  </ItemGroup>

</Project>
