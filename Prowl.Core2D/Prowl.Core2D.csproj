<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The 2D runtime that translates to C: nodes, components, the scene's lifecycle, the physics components and the simulation core under them.
    This file is the ONE list of what it is. An item marked Feature="x" is translated only for a game that names that feature (tools/ccsharp/ccsharp_scan.py FEATURES). The .NET build compiles it; `python3 build.py player` reads the same list (the items marked
    CBuild="false" are the .NET-only bindings, which the C build replaces with the generated C flavor) and translates it with the game's
    scripts. Add a file here and both builds have it.

    It depends on nothing: no NuGet package, no Prowl.Runtime assembly. The physics core is linked in from Prowl.Runtime/Physics2D, where the
    engine's own 2D physics uses the same files.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Prowl.Core2D</RootNamespace>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup Label="Physics core (shared with Prowl.Runtime)">
    <Compile Include="..\Prowl.Runtime\Physics2D\MaxInstancesAttribute.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\Arena.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\Pose2D.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\Collider2DGeometry.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\HandleTable.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\TriggerSet.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\ContactSet.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\BodyRecord.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\JointRecord.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\Registry2D.cs" />
    <Compile Include="..\Prowl.Runtime\Physics2D\SimCore2D.cs" />
  </ItemGroup>

  <ItemGroup Label="Pixel terrain (shared with Prowl.Runtime; a game that uses it)">
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelMath.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelRange.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelColumn.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\StampShape.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelRect.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelQuadTree.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelRectMerge.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelTerrainLimits.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelChunk.cs" Feature="terrain" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\PixelTerrain\PixelChainTrace.cs" Feature="terrain" />
  </ItemGroup>
  <ItemGroup Label="Shattering (shared with Prowl.Runtime; a game that uses it)">
    <Compile Include="..\Prowl.Runtime\Destruction2D\Shatter\PolySet.cs" Feature="destruction" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\Shatter\Fracturer.cs" Feature="destruction" />
    <Compile Include="..\Prowl.Runtime\Destruction2D\Shatter\ExplodeOptions.cs" Feature="destruction" />
  </ItemGroup>
  <ItemGroup Label="Native bindings (.NET flavor; the C build uses the generated C flavor instead)">
    <Compile Include="..\Prowl.Runtime\Physics2D\Native\PB2.Generated.cs" CBuild="false" />
  </ItemGroup>

  <ItemGroup Label="The runtime">
    <Compile Include="CoreLimits.cs" />
    <Compile Include="ScriptAttribute.cs" />
    <Compile Include="Node.cs" />
    <Compile Include="Component.cs" />
    <Compile Include="Rigidbody2D.cs" />
    <Compile Include="Collider2D.cs" />
    <Compile Include="World2D.cs" />
    <Compile Include="SpriteRenderer2D.cs" />
    <Compile Include="MeshRenderer2D.cs" />
    <Compile Include="Renderer2D.cs" />
    <Compile Include="Scene2D.cs" />
    <Compile Include="PixelTerrain2D.cs" Feature="terrain" />
    <Compile Include="Shatter2D.cs" Feature="destruction" />
  </ItemGroup>

  <!-- The in-game UI draws with the renderer, whose C# bindings (GFX) are generated when a game is built (tools/ccsharp/gen_pb2.py --lib gfx2d), so a plain
       `dotnet build` of this project leaves it out. A game that uses it is built by `python3 build.py player`, which adds the bindings; to compile it by hand,
       add the generated GFX.net.cs and pass -p:Prowl2DGfx=true. -->
  <ItemGroup Label="In-game UI (a game that uses it)" Condition="'$(Prowl2DGfx)' == 'true'">
    <Compile Include="UI\UIText.cs" Feature="ui" />
  </ItemGroup>

</Project>
